layout: null
---
<?xml version="1.0" encoding="UTF-8"?>
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9">
  <url><loc>{{ '/' | absolute_url }}</loc></url>
  <url><loc>{{ '/folgen/' | absolute_url }}</loc></url>
  <url><loc>{{ '/erlass-guesser.html' | absolute_url }}</loc></url>
{%- for f in site.folgen -%}
  {%- assign t = f.content | strip -%}
  {%- if t != "" %}
  <url><loc>{{ f.url | absolute_url }}</loc><lastmod>{{ f.datum | date: "%Y-%m-%d" }}</lastmod></url>
  {%- endif -%}
{%- endfor %}
</urlset>
